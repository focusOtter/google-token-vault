# Auth0 Regular Web Application (no protocol in domain)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Optional dedicated Google connection; defaults to google-oauth2
AUTH0_GOOGLE_CONNECTION=google-oauth2
# openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Local only; Vercel uses OIDC automatically
AI_GATEWAY_API_KEY=
# Optional model override
AI_MODEL=openai/gpt-4.1-mini
